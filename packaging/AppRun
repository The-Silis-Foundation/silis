#!/bin/bash
# ==============================================================================
# Silis ASIC EDA Self-Contained AppRun for 100% Standalone AppImage Execution
# ==============================================================================
set -e

# Resolve base directories
if [ -z "$APPDIR" ]; then
    APPDIR="$(cd "$(dirname "$0")" && pwd)"
fi

export APPDIR
export REPO_ROOT="$APPDIR"

# 1. PDK Root resolution (prioritize host ~/.silis/pdks if populated, else bundle fallback)
if [ -z "${PDK_ROOT:-}" ]; then
    if [ -d "$HOME/.silis/pdks/sky130A" ]; then
        export PDK_ROOT="$HOME/.silis/pdks"
    elif [ -d "$APPDIR/assets/pdk/sky130A" ]; then
        export PDK_ROOT="$APPDIR/assets/pdk"
    else
        export PDK_ROOT="$HOME/.silis/pdks"
    fi
fi
mkdir -p "$HOME/.silis/pdks" 2>/dev/null || true

# 2. Standalone Python Selection & Environment Isolation
export PYTHONNOUSERSITE=1
if [ -d "$APPDIR/opt/python" ]; then
    export PYTHONHOME="$APPDIR/opt/python"
    export PYTHON_BIN="$APPDIR/opt/python/bin/python3"
    export PATH="$APPDIR/opt/python/bin:$PATH"
    PY_SITE="$APPDIR/opt/python/lib/python3.12/site-packages"
elif [ -f "$APPDIR/usr/bin/python3" ]; then
    export PYTHON_BIN="$APPDIR/usr/bin/python3"
    PY_SITE="$APPDIR/usr/lib/python3.12/site-packages"
else
    export PYTHON_BIN="$(which python3 2>/dev/null || echo "python3")"
    PY_SITE=""
fi

# 3. Dynamic Library Paths (Include embedded Qt6 and OpenROAD shared libraries)
QT6_LIB="$PY_SITE/PyQt6/Qt6/lib"
WEBENGINE_LIB="$PY_SITE/PyQt6_WebEngine/Qt6/lib"
BASE_LD_PATH="$APPDIR/usr/lib:$APPDIR/usr/lib/x86_64-linux-gnu:$APPDIR/opt/python/lib:$QT6_LIB:$WEBENGINE_LIB:$APPDIR/third-party/bin:$APPDIR/third-party/plugins:$APPDIR/third-party/ordlibs:$APPDIR/core/backendflow/def_viewer_cpp/build:$APPDIR/backendflow/def_viewer_cpp/build"
if [ -n "${LD_LIBRARY_PATH:-}" ]; then
    export LD_LIBRARY_PATH="$BASE_LD_PATH:$LD_LIBRARY_PATH"
else
    export LD_LIBRARY_PATH="$BASE_LD_PATH"
fi

# 4. Strict Isolated PYTHONPATH (prioritize bundled wheels, then repo core, third-party)
if [ -n "$PY_SITE" ] && [ -d "$PY_SITE" ]; then
    BASE_PYPATH="$PY_SITE:$APPDIR:$APPDIR/core:$APPDIR/third-party:$APPDIR/third-party/python-packages"
else
    BASE_PYPATH="$APPDIR:$APPDIR/core:$APPDIR/third-party:$APPDIR/third-party/python-packages"
fi
if [ -n "${PYTHONPATH:-}" ]; then
    export PYTHONPATH="$BASE_PYPATH:$PYTHONPATH"
else
    export PYTHONPATH="$BASE_PYPATH"
fi

# 5. Qt6 & QtWebEngine Discovery
# Force software rendering in Chromium to eliminate GBM/Vulkan driver crashes across arbitrary Linux GPUs/VMs
export QTWEBENGINE_CHROMIUM_FLAGS="--disable-logging --log-level=3 --disable-gpu"

if [ -f "$PY_SITE/PyQt6/Qt6/libexec/QtWebEngineProcess" ]; then
    export QTWEBENGINEPROCESS_PATH="$PY_SITE/PyQt6/Qt6/libexec/QtWebEngineProcess"
    export QTWEBENGINE_RESOURCES_PATH="$PY_SITE/PyQt6/Qt6/resources"
    export QTWEBENGINE_LOCALES_PATH="$PY_SITE/PyQt6/Qt6/translations/qtwebengine_locales"
elif [ -f "$PY_SITE/PyQt6_WebEngine/Qt6/libexec/QtWebEngineProcess" ]; then
    export QTWEBENGINEPROCESS_PATH="$PY_SITE/PyQt6_WebEngine/Qt6/libexec/QtWebEngineProcess"
    export QTWEBENGINE_RESOURCES_PATH="$PY_SITE/PyQt6_WebEngine/Qt6/resources"
    export QTWEBENGINE_LOCALES_PATH="$PY_SITE/PyQt6_WebEngine/Qt6/translations/qtwebengine_locales"
elif [ -f "$APPDIR/usr/lib/qt6/libexec/QtWebEngineProcess" ]; then
    export QTWEBENGINEPROCESS_PATH="$APPDIR/usr/lib/qt6/libexec/QtWebEngineProcess"
    export QTWEBENGINE_RESOURCES_PATH="$APPDIR/usr/share/qt6/resources"
    export QTWEBENGINE_LOCALES_PATH="$APPDIR/usr/share/qt6/translations/qtwebengine_locales"
fi

# 6. EDA Binaries in PATH (Verilator, OpenROAD, Yosys, OpenSTA, Volare, silis_def_viewer)
export PATH="$APPDIR/third-party/bin:$APPDIR/core/backendflow/def_viewer_cpp/build:$APPDIR/backendflow/def_viewer_cpp/build:$APPDIR/third-party/OpenROAD/build/src:$APPDIR/third-party/OpenSTA/build:$PATH"
export VERILATOR_ROOT="$APPDIR/third-party/share/verilator"

# 7. Verilator compilation optimization & ccache fallback
if ! command -v ccache &>/dev/null; then
    export OBJCACHE=""
fi

# 8. Dedicated CLI switches for SDK and First-Boot handling
if [ "${1:-}" = "--install-sdk" ]; then
    exec "$PYTHON_BIN" "$APPDIR/core/sdk_installer.py" --force "$APPIMAGE"
fi

if [ "${1:-}" = "--first-boot" ]; then
    exec "$PYTHON_BIN" -c "import sys; sys.path.insert(0, '$APPDIR'); sys.path.insert(0, '$APPDIR/core'); from core.setup_wizard import run_first_boot_if_needed; run_first_boot_if_needed()"
fi

if [ "${1:-}" = "--python" ]; then
    shift
    exec "$PYTHON_BIN" "$@"
fi

if [ "${1:-}" = "-c" ]; then
    exec "$PYTHON_BIN" "$@"
fi

exec "$PYTHON_BIN" "$APPDIR/silis.py" "$@"
